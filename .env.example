# ==============================================================================
# SlotSathi Recover — Environment Variables Template
# ==============================================================================
# Note: In development and test environments without Supabase credentials,
# SlotSathi automatically operates using its built-in in-memory transaction store.
#
# When connecting to Supabase PostgreSQL:
# 1. Provide your project URL and publishable anon key.
# 2. Never commit live production secrets into version control.
# ==============================================================================

# Supabase Project Connection (Optional in development, required for production PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Playwright Test Base URL (Defaults to http://localhost:3000 if not set)
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
